// Mission 02: the KQL I ran in Sentinel → Logs
// Times in UTC. Replace the attack window below with the one the coach gave me.

// Is my machine still sending? (check before trusting "nothing found")
Heartbeat
| where Computer startswith "WKS-L58"
| summarize LastSeen = max(TimeGenerated)

// ---------------------------------------------------------------------------
// KQL warm-up (on my own labuser events from step 0)
// ---------------------------------------------------------------------------

// Step 4: only my labuser events (filter on TargetUserName, not Account)
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| project TimeGenerated, Account, IpAddress, EventID, Activity

// Step 6: failures vs successes, and from where
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| where EventID in (4624, 4625)
| summarize Attempts = count() by EventID, IpAddress
| sort by Attempts desc

// Step 7: the story in time order (failures, then the success)
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| where EventID in (4624, 4625)
| sort by TimeGenerated asc
| project TimeGenerated, EventID, IpAddress, LogonType

// Part 1: everything my labuser session left behind (logon, sign-out, and whether whoami shows up at all)
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser" or SubjectUserName == "labuser"
| summarize count() by EventID, Activity
| order by EventID asc

// ---------------------------------------------------------------------------
// Part 2: hunt (Temps 1)
// ---------------------------------------------------------------------------

// Every successful RDP logon, newest first (how I found my own labuser logon in Part 1, and where the intruder's will show up in Part 2)
SecurityEvent
| where EventID == 4624
| where LogonType == 10
| project TimeGenerated, Computer, TargetUserName, IpAddress, LogonTypeName, Activity
| sort by TimeGenerated desc

// Part 2: everything about the compromised account (failures and successes, every logon type, in time order)
SecurityEvent
| where TimeGenerated > ago(7d)
| where TargetUserName == "helpdesk"
| where EventID in (4624, 4625, 4634, 4647)
| project TimeGenerated, EventID, Activity, LogonType, LogonTypeName, IpAddress, WorkstationName, Status, SubStatus
| sort by TimeGenerated asc

// Part 2: helpdesk summary by logon type and source (this gave the source IP)
SecurityEvent
| where TimeGenerated > ago(48h)
| where TargetUserName == "helpdesk"
| where EventID in (4624, 4625)
| summarize Fail = countif(EventID == 4625), OK = countif(EventID == 4624),
            First = min(TimeGenerated), Last = max(TimeGenerated)
            by LogonType, IpAddress, WorkstationName

// Part 2: helpdesk rounds per minute (this showed the 4 rounds of 5 failures, then success)
SecurityEvent
| where TimeGenerated > ago(48h)
| where TargetUserName == "helpdesk"
| where EventID in (4624, 4625)
| summarize Failed = countif(EventID == 4625),
            OK_type3 = countif(EventID == 4624 and LogonType == 3),
            OK_type10 = countif(EventID == 4624 and LogonType == 10),
            Start = min(TimeGenerated)
            by bin(TimeGenerated, 1m)
| sort by Start asc

// Part 2, challenge 2: every RDP logon of helpdesk, newest first (source IP)
SecurityEvent
| where EventID == 4624
| where LogonType == 10
| where TargetUserName == "helpdesk"
| project TimeGenerated, Computer, TargetUserName, IpAddress, LogonTypeName, Activity
| sort by TimeGenerated desc

// Part 2, challenge 3: everything from the attacker's IP in time order (the brute-force shape)
SecurityEvent
| where EventID in (4625, 4624)
| where IpAddress == "10.50.0.100"
| project TimeGenerated, EventID, Activity, TargetUserName, IpAddress, LogonType
| sort by TimeGenerated asc

// Who was knocking? Failed and successful logons per account and source, excluding machine accounts
let windowStart = datetime(2026-10-12 00:00);   // TODO: attack window start (UTC)
let windowEnd   = datetime(2026-10-12 23:59);   // TODO: attack window end (UTC)
SecurityEvent
| where TimeGenerated between (windowStart .. windowEnd)
| where EventID in (4624, 4625)
| where TargetUserName !endswith "$" and TargetUserName !in ("SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE", "ANONYMOUS LOGON")
| summarize Failures = countif(EventID == 4625), Successes = countif(EventID == 4624),
            First = min(TimeGenerated), Last = max(TimeGenerated)
            by TargetUserName, IpAddress, WorkstationName
| sort by Failures desc

// The shape over time for one account (replace the name with the one from the query above)
SecurityEvent
| where TimeGenerated > ago(7d)
| where TargetUserName == "TODO_account"
| where EventID in (4624, 4625)
| sort by TimeGenerated asc
| project TimeGenerated, EventID, LogonType, IpAddress, WorkstationName, Status, SubStatus

// Failures per minute: a burst is the "shape" of password guessing
SecurityEvent
| where TimeGenerated > ago(7d)
| where EventID == 4625
| summarize Failures = count() by bin(TimeGenerated, 1m), TargetUserName, IpAddress
| where Failures > 5
| sort by TimeGenerated asc

// The successful logon in full (expand the row: TargetUserName, IpAddress, LogonType, WorkstationName)
SecurityEvent
| where TimeGenerated > ago(7d)
| where TargetUserName == "TODO_account"
| where EventID == 4624

// ---------------------------------------------------------------------------
// Part 3: the gap
// ---------------------------------------------------------------------------

// Is there anything that shows a command? (expected empty in Temps 1: no process creation auditing)
SecurityEvent
| where TimeGenerated > ago(7d)
| where EventID == 4688
| take 10

// Part 3: is there any 4688 or 4104 at all? (both 0 over 7 days in Temps 1)
union (SecurityEvent | where TimeGenerated > ago(7d) | where EventID == 4688 | summarize n = count() | extend t = "4688 last 7d"),
      (Event | where TimeGenerated > ago(7d) | where EventID == 4104 | summarize n = count() | extend t = "4104 last 7d")

// Part 3: helpdesk activity around flag.txt (created 13:13:01 UTC)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12 13:10) .. datetime(2026-10-12 13:20))
| where TargetUserName == "helpdesk" or SubjectUserName == "helpdesk"
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by EventID, Activity
| sort by FirstSeen asc

// ---------------------------------------------------------------------------
// Part 4: after the policy change (Temps 2)
// ---------------------------------------------------------------------------

// What's new since the policy change? Event IDs seen after it that never appeared before (answer: 4688, first at 13 Oct 08:23:15 UTC)
let policyChange = datetime(2026-10-13 08:00);
let before = SecurityEvent | where TimeGenerated between (ago(30d) .. policyChange) | distinct EventID;
SecurityEvent
| where TimeGenerated > policyChange
| where EventID !in (before)
| summarize Count = count(), First = min(TimeGenerated), Example = any(Activity) by EventID

// Part 4: the replayed intrusion (logons of helpdesk on 13 Oct)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-13 08:00) .. datetime(2026-10-13 09:30))
| where TargetUserName == "helpdesk"
| where EventID in (4624, 4625, 4634, 4647, 4648)
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by EventID, LogonType, IpAddress
| sort by FirstSeen asc

// Part 4: process creation with the command line for helpdesk (this gave the command)
SecurityEvent
| where EventID == 4688
| where isnotempty(CommandLine)
| where SubjectUserName == "helpdesk"
| project TimeGenerated, SubjectUserName, NewProcessName, ParentProcessName, CommandLine
| sort by TimeGenerated asc
